# ========================================================
# JudoPro-Backend 环境变量与本地开发配置模板
# 生产环境或本地私有调试时，请配置系统环境变量或复制本文件为私有配置
# 警告：请勿将包含真实密钥或密码的文件提交至公共 Git 仓库！
# ========================================================

# 数据库连接配置
DB_URL=jdbc:mysql://localhost:3306/JudoPro?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_database_password

# 火山引擎多模态 AI 大模型配置
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com
VOLCENGINE_API_KEY=your_volcengine_api_key_here

# Python 视觉微服务（姿态识别与动作检测）
PYTHON_SERVICE_HOST=127.0.0.1
PYTHON_BINARY_PORT=8000
